{
    "extends": "../../packages/config/tsconfig.base.json",
    "compilerOptions":{
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
